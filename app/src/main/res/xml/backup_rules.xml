<?xml version="1.0" encoding="utf-8"?><!--
   Regras de backup para API < 31. Ver data_extraction_rules.xml.
-->
<full-backup-content>
    <!-- Cifrado com chave do Keystore, que não acompanha o backup: restaurado em outro aparelho,
         o arquivo seria indecifrável e tratado como adulterado. -->
    <exclude domain="file" path="datastore/encrypted-preferences" />
</full-backup-content>
