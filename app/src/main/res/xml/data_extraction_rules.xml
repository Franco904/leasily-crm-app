<?xml version="1.0" encoding="utf-8"?><!--
   Regras de backup e transferência entre aparelhos para API 31+.
   Ver https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <!-- Cifrado com chave do Keystore, que não acompanha o backup nem a transferência: restaurado
         em outro aparelho, o arquivo seria indecifrável e tratado como adulterado. -->
    <cloud-backup>
        <exclude domain="file" path="datastore/encrypted-preferences" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/encrypted-preferences" />
    </device-transfer>
</data-extraction-rules>
